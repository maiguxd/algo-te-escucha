{
  "format_version": "1.10.0",
  "minecraft:client_entity": {
    "description": {
      "identifier": "listener:the_listener",
      "materials": {
        "default": "entity_alphatest"
      },
      "textures": {
        "default": "textures/entity/the_listener"
      },
      "geometry": {
        "default": "geometry.the_listener"
      },
      "animations": {
        "idle": "animation.the_listener.idle",
        "walk": "animation.the_listener.walk",
        "stare": "animation.the_listener.stare"
      },
      "scripts": {
        "animate": [
          { "stare": "query.mark_variant == 1" },
          { "walk": "query.mark_variant == 2" },
          { "idle": "query.mark_variant != 1 && query.mark_variant != 2" }
        ]
      },
      "render_controllers": ["controller.render.the_listener"],
      "spawn_egg": {
        "base_color": "#1a1e22",
        "overlay_color": "#3a4248"
      }
    }
  }
}
